#!/bin/bash

#$ -N tPredJOB
#$ -cwd
#$ -m bae
#$ -M username@email.com

export RSCRIPT="/path/to/your/Rscript/executable"
export PATH=$PATH:$RSCRIPT

COREDIR="/path/to/your/targPred/code"

echo "adding target genes to GRB"
Rscript ${COREDIR}adding_target_genes_to_grbs.R

echo "Running GWAS SNPs in GRB"
Rscript ${COREDIR}gwas_snps_in_grb.R

if [ ! -d "plots" ];
then
    mkdir "plots"
fi
if [ ! -d "plots/expression_pairs" ];
then
    mkdir "plots/expression_pairs"
fi
if [ ! -d "plots/gviz_plots" ];
then
    mkdir "plots/gviz_plots"
fi

echo "Creating EP pair beanplots"
Rscript ${COREDIR}locus_summary_plots.R
echo "Creating Gviz plots"
Rscript ${COREDIR}locus_summary_plots_gviz.R
echo "Job finished"
