#!/bin/bash

#$ -N plink2_TSI
#$ -cwd
#$ -m bae
#$ -pe mpi 8
#$ -M dalibor.hrsak@irb.hr

export PLINK2="/home/dhrsak/MyPrograms/plink2"
export PATH=$PATH:$PLINK2

POP="EUR"

plink2 --pfile all_phase3 vzs --chr 1-22 --output-chr 26 --max-alleles 2 --rm-dup exclude-mismatch --set-missing-var-ids '@_#_$1_$2' --make-pgen --allow-extra-chr --new-id-max-allele-len 500 --out all_phase3_autosomes

# Prepare sub-population filter file
# here $6 == CEU or IBS or whatever
# but $5 == EUR
awk 'NR == 1 || $6 == "TSI" {print $1}' all_phase3.psam > ${POP}_1kg_samples.txt

# Generate sub-population fileset
plink2 --pfile all_phase3_autosomes --keep ${POP}_1kg_samples.txt --make-pgen --allow-extra-chr --new-id-max-allele-len 500 --out ${POP}_phase3_autosomes

# prepare plink2 output for plink
plink2 --pfile ${POP}_phase3_autosomes --maf 0.005 --make-bed --allow-extra-chr --new-id-max-allele-len 500 --out ${POP}_phase3_autosomes
for i in {1..22}
do 
    plink2 --bfile ${POP}_phase3_autosomes --chr $i --make-bed --allow-extra-chr --new-id-max-allele-len 500 --out ${POP}_phase3_chr$i
done

echo "----- job finished----"
