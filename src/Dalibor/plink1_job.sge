#!/bin/bash

#$ -N plinkEUR
#$ -cwd
#$ -m bae
#$ -pe mpi 8
#$ -M dalibor.hrsak@irb.hr

export PLINK="/home/dhrsak/MyProjects/plink/plink_linux_x86_64_20230116/"
export PATH=$PATH:$PLINK
export RSCRIPT="/home/dhrsak/MyPrograms/miniconda3/bin"
export PATH=$PATH:$RSCRIPT

SNPLIST=gwas_snps_2021.txt

for i in {1..22}
do
    NAME=EUR_phase3_chr${i}
    plink --bfile /storage/PROJECTS/targPred/dalibor/targPred/plink_jobs/test_plink2/hg37/pop_EUR/input/${NAME} --r2 --ld-snp-list ${SNPLIST} --ld-window-kb 500 --ld-window 99999 --ld-window-r2 0.6 --noweb --allow-extra-chr --out out/${NAME}

    Rscript process_plink.R ${NAME}

done
